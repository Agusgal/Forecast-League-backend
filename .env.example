# Leave BOTH values empty for the clearly labeled, persistent local demo.
# Set both to enable Supabase Auth + PostgreSQL after following supabase/README.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Use only a PUBLIC anon JWT or sb_publishable_* key above.
# Never put a service_role JWT or sb_secret_* key in this application.

# Optional local demo file override (absolute path recommended).
# Default: .data/forecast-league.json beneath the project directory.
# FORECAST_DATA_PATH=/absolute/path/to/forecast-league.json
